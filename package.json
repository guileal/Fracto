{
  "name": "fracto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc -b && vite build",
    "build:wp": "npm run build --prefix wordpress",
    "wp": "npm run wp --prefix wordpress --",
    "wp:list": "npm run wp --prefix wordpress -- list",
    "wp:scaffold": "npm run wp --prefix wordpress -- scaffold",
    "wp:export": "npm run wp --prefix wordpress -- export",
    "wp:unexport": "npm run wp --prefix wordpress -- unexport",
    "wp:sync": "npm run wp --prefix wordpress -- sync",
    "preview": "vite preview"
  },
  "dependencies": {
    "three": "^0.184.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/three": "^0.184.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
